# Required at import. Copy to .env and replace the placeholders.
# Do not use the admin/admin pair: the process refuses to start with it.
API_KEY=sk-your-openai-key-here
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/ai_chat
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. Defaults match these values when the variables are unset.
MODEL=gpt-4o-mini
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
