# Copy to .env in the repo root (gitignored) before `docker compose up`.
# Do not commit .env. The backend refuses to start when SECRET_KEY or
# ADMIN_PASSWORD is still the placeholder below, and when the admin login
# and password are the admin/admin pair.

# OpenAI key used by the chat backend.
API_KEY=sk-your-openai-key-here

# Replace both. These exact strings are rejected at startup.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. Defaults match these values when the variables are unset.
# MODEL=gpt-4o-mini
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# Expose /docs, /redoc, and /openapi.json. Unset or false leaves all three off.
# ENABLE_API_DOCS=false

# Browser origin of the page on the host. One origin, no wildcard.
FRONTEND_ORIGIN=http://localhost:5173

# Local Postgres defaults. These are not the SECRET_KEY or ADMIN_PASSWORD
# placeholders. If you change the user, password, or database, change
# DATABASE_URL the same way. The host name is the Compose service `postgres`.
# Keep the password free of @ : / or percent-encode it in DATABASE_URL.
POSTGRES_USER=ai_chat
POSTGRES_PASSWORD=ai_chat_local
POSTGRES_DB=ai_chat
DATABASE_URL=postgresql+psycopg2://ai_chat:ai_chat_local@postgres:5432/ai_chat
